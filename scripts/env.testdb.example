# Copy to .env.testdb.local (git-ignored) and fill in a SEPARATE Supabase project.
# Used only by `npm`/Paseo script "dev-test" (port 3100). Never use the live project's values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: skip the login screen with the test project's own user.
# LOCAL_AUTO_LOGIN_EMAIL=
# LOCAL_AUTO_LOGIN_PASSWORD=
# Set to yes once you have checked the values above belong to the TEST project.
TEST_DB_CONFIRMED=
